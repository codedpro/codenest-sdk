{
  "name": "@itmaster/sdk",
  "version": "0.1.0",
  "description": "Client SDK for the IT Master content engine — pull published articles + Next.js helpers. Use this instead of re-implementing the Pull API in every site.",
  "type": "module",
  "license": "UNLICENSED",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "next": ">=14"
  },
  "peerDependenciesMeta": {
    "next": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^20.0.0"
  }
}
