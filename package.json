{
  "name": "@code-nest/sdk",
  "version": "0.5.0",
  "description": "Connect any Next.js site to CodeNest \u2014 the AI SEO content engine that writes, validates & publishes expert articles that rank on Google and get cited by AI search: sitemap, robots, llms.txt, IndexNow, JSON-LD, metadata & webhooks.",
  "type": "module",
  "license": "MIT",
  "author": "CodeNest (https://code-nest.dev)",
  "homepage": "https://code-nest.dev/docs/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codedpro/codenest-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/codedpro/codenest-sdk/issues"
  },
  "keywords": [
    "codenest",
    "nextjs",
    "next",
    "app-router",
    "typescript",
    "seo",
    "ai-seo",
    "ai-content",
    "content-engine",
    "programmatic-seo",
    "seo-automation",
    "generative-engine-optimization",
    "ai-search",
    "llms-txt",
    "seo-content",
    "content-api",
    "pull-api",
    "headless-cms",
    "blog",
    "sitemap",
    "robots-txt",
    "rss",
    "indexnow",
    "json-ld",
    "structured-data",
    "rich-results",
    "metadata",
    "schema-org",
    "webhooks",
    "cms-client"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "next": ">=14"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.6.0"
  },
  "bin": {
    "codenest-sdk": "./dist/cli.js"
  },
  "private": true
}
